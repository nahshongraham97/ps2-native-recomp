a97ef3","patch":"@@ -0,0 +1,32 @@\n+#include <common-iop.h>\n+#include <string.h>\n+\n+//vsprintf is not reliable on a real PS2, we can't use it. We rely on this macro instead.\n+#define EXECUTE_TEST(output, format, ...) sprintf(output, format, __VA_ARGS__); printf(\"%s: %s\\n\", format, output);\n+\n+int _start(int argc, char **argv) {\n+\tprintf(\"-- TEST BEGIN\\n\");\n+\t\n+\tchar buffer[256];\n+\n+\tEXECUTE_TEST(buffer, \"%d\", 32);\n+\tEXECUTE_TEST(buffer, \"%03d\", 45);\n+\tEXECUTE_TEST(buffer, \"%3d\", 12);\n+\tEXECUTE_TEST(buffer, \"%3.3d\", 87);\n+\tEXECUTE_TEST(buffer, \"%+6d\", 948);\n+\tEXECUTE_TEST(buffer, \"%+6d\", -948);\n+\tEXECUTE_TEST(buffer, \"%6d\", -948);\n+\tEXECUTE_TEST(buffer, \"%06d\", -948);\n+\tEXECUTE_TEST(buffer, \"%+06d\", 948);\n+\tEXECUTE_TEST(buffer, \"%u\", -948);\n+\tEXECUTE_TEST(buffer, \"%s%3.3d\", \"myfile\", 0);\n+\tEXECUTE_TEST(buffer, \"%x\", 0xdeadbeef);\n+\tEXECUTE_TEST(buffer, \"%X\", 0xDEADBEEF);\n+\tEXECUTE_TEST(buffer, \"%08x\", 23);\n+\tEXECUTE_TEST(buffer, \"%8x\", 12);\n+\tEXECUTE_TEST(buffer, \"%p\", (void*)0x01234567);\n+\tEXECUTE_TEST(buffer, \"%c\", 'j');\n+\t\n+\tprintf(\"-- TEST END\\n\");\n+\treturn 0;\n+}"},{"sha":"a96bfd1e6a8a3763739730b68d9b6f192d7cbbb8","filename":"tests/kernel/iop/libc/sprintf.expected","status":"added","additions":19,"deletions":0,"changes":19,"blob_url":"https://github.com/unknownbrackets/ps2autotests/blob/97469ffbed8631277b94e28d01dabd702aa97ef3/tests%2Fkernel%2Fiop%2Flibc%2Fsprintf.expected","raw_url":"https://github.com/unknownbrackets/ps2autotests/raw/97469ffbed8631277b94e28d01dabd702aa97ef3/tests%2Fkernel%2Fiop%2Flibc%2Fsprintf.expected","contents_url":"https://api.github.com/repos/unknownbrackets/ps2autotests/contents/tests%2Fkernel%2Fiop%2Flibc%2Fsprintf.expected?ref=97469ffbed8631277b94e28d01dabd702aa97ef3","patch":"@@ -0,0 +1,19 @@\n+-- TEST BEGIN\n+%d: 32\n+%03d: 045\n+%3d:  12\n+%3.3d: 087\n+%+6d:   +948\n+%+6d:   -948\n+%6d:   -948\n+%06d: -00948\n+%+06d: +00948\n+%u: 4294966348\n+%s%3.3d: myfile000\n+%x: deadbeef\n+%X: DEADBEEF\n+%08x: 00000017\n+%8x:        c\n+%p: 1234567\n+%c: j\n+-- TEST END"},{"sha":"358880f47c8507e36ffbfd2167ae7366267eab38","filename":"tests/kernel/iop/libc/sprintf.irx","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/unknownbrackets/ps2autotests/blob/97469ffbed8631277b94e28d01dabd702aa97ef3/tests%2Fkernel%2Fiop%2Flibc%2Fsprintf.irx","raw_url":"https://github.com/unknownbrackets/ps2autotests/raw/97469ffbed8631277b94e28d01dabd702aa97ef3/tests%2Fkernel%2Fiop%2Flibc%2Fsprintf.irx","contents_url":"https://api.github.com/repos/unknownbrackets/ps2autotests/contents/tests%2Fkernel%2Fiop%2Flibc%2Fsprintf.irx?ref=97469ffbed8631277b94e28d01dabd702aa97ef3"}]}