"""Commit reviewed native startup ownership; remote loss never deletes local work."""
import ast, hashlib, json, pathlib, subprocess

F = pathlib.Path(__file__).resolve().parents[3]
P = F.parents[2]
RUN = pathlib.Path(__file__).resolve().parent
S = P / 'research/runs/native-retail-startup-20261120'
R = S / 'native-heap/retail-owner-group'
for path, selected in [
    (F / 'research/runs/native-service-runtime-20261120/publish.py', {'sha', 'need', 'git', 'names'}),
    (F / 'research/runs/native-wave-allocation-20261120/publish.py', {'remote_state', 'commit_sync'})]:
    tree = ast.parse(path.read_text(encoding='utf-8'))
    tree.body = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in selected]
    exec(compile(tree, str(path), 'exec'))

base_f = '04c6975e52961ee36673363ef36fa3227bb755a5'
base_p = 'a7bf17fb94a06187f253c04f18bead940ffd17be'
for root, expected in [(F, base_f), (P, base_p)]:
    need(git(root, 'branch', '--show-current') == 'main' and git(root, 'rev-parse', 'HEAD') == expected, 'expected local base')
    need(not names(root, 'diff', '--cached', '--name-only', '-z'), 'empty initial index')
vf = RUN / 'validation-01/verification.json'; v = json.loads(vf.read_bytes())
need(v['status'] == 'PASS_NATIVE_RETAIL_OWNER_GROUP_AND_STARTUP_OWNERSHIP' and
     len(v['source_after_sha256']) == 835 and len(v['fixtures']) == 4 and v['unchanged_prior_pins'] == 745 and
     v['actual_fault_counts'] == {'create': 25, 'bind': 2}, 'actual completed component certificate')
for name, digest in v['source_after_sha256'].items(): need(sha(name) == digest, 'current measured input')
for stem, status in [('FINAL_SOURCE_REVIEW', 'SOURCE_REVIEW_NATIVE_RETAIL_MEMORY_OWNER_GROUP_AND_FAULT_FIXTURE_VERIFIED'),
                     ('EXECUTION_REVIEW', 'SAVED_NATIVE_RETAIL_OWNER_GROUP_EXECUTION_VERIFIED')]:
    report = json.loads((R / (stem + '.json')).read_bytes())
    need(report['status'] == status and isinstance(report['input_sha256'], dict), 'actual review producer schema')
    for name, digest in report['input_sha256'].items(): need(sha(name) == digest, 'current review pin')
preserved = {'runtime/src/iop/mcserv.cpp': 'ad2731a341409d87ffe1b171e99f28d7cedc5004aaf375a565d78673333414fb',
             'runtime/src/iop/msl_native.cpp': '756cfb3867ebb440223ddb8ab6fe441ad6f9f54d35e4119a8342f8dd9063bb23'}
for name, digest in preserved.items(): need(sha(F / name) == digest, 'preserved unrelated IOP bytes')
need(sha(P / 'research/doc-audit-20261118/inventory.json') == '26093151039b949348184f2e8a960b92d64e7f08408d43e58e1e0ed481a959f6', 'preserved broad inventory')
fork_files = {F / name for name in ['cmake/native_game.cmake', 'recomp/native_startup_codegen.cpp',
    'tests/test_native_startup_codegen.cpp', 'tests/test_native_retail_startup.cpp',
    'runtime/include/mka/retail_memory_owners.hpp', 'runtime/src/native/retail_memory_owners.cpp',
    'tests/test_retail_memory_owners.cpp', 'tests/test_retail_memory_owner_faults.cpp']}
fork_files.update(q for q in RUN.rglob('*') if q.is_file() and '__pycache__' not in q.parts)
parent_files = {P / n for n in ['PORT_STATUS.md', 'ROADMAP.md']}
parent_files.update(q for q in R.rglob('*') if q.is_file())
parent_files.update(S / n for n in ['MAIN_AFTER_MEMORY_SOURCE.md', 'MAIN_AFTER_MEMORY_SOURCE.json'])
parent_files.update(q for q in (S / 'words-main-after-memory').rglob('*') if q.is_file())
for root, files in [(F, fork_files), (P, parent_files)]:
    for q in files:
        b = q.read_bytes()
        need(b'\r' not in b and b.endswith(b'\n') and not b.endswith(b'\n\n') and
             all(line == line.rstrip(b' \t') for line in b.splitlines()), 'authored/snapshot LF/EOF: ' + str(q))
    allowed = {q.relative_to(root).as_posix() for q in files}
    need(names(root, 'diff', '--name-only', '-z') - allowed <=
         ({'research/doc-audit-20261118/inventory.json'} if root == P else set()), 'only authored tracked modifications')
    subprocess.run(['git', '-c', 'core.autocrlf=false', 'diff', '--check', '--', *sorted(allowed)], cwd=root, check=True)
remote_f, remote_p = remote_state(F, base_f), remote_state(P, base_p)
head, sync_f = commit_sync(F, fork_files, 'Connect generated retail startup to native ordered memory owners', remote_f)
prefix = ('Published fork `' if sync_f['synchronization'] == 'verified' else 'Local fork `') + head + '`: '
for name in ['PORT_STATUS.md', 'ROADMAP.md']:
    q = P / name; text = q.read_text(encoding='utf-8')
    marker = 'Integrated native owner-group/startup ownership now passes4 actual native clients'
    need(text.count(marker) == 1, 'single current owner-group result')
    text = text.replace(marker, prefix + 'integrated native owner-group/startup ownership passes4 actual native clients')
    text = text.replace('Independent saved-results review is pending;',
        'Independent saved-results review verifies all4 executions, exact source/binary/tool/generated joins and expected incomplete-entry refusal;')
    if name == 'PORT_STATUS.md':
        marker = '| Current native source checkpoint | Published fork '
        need(text.count(marker) == 1, 'single current checkpoint row')
        text = text.replace(marker, '| Current native source checkpoint | ' + prefix +
            'generated startup owns actual ordered native memory group;4 clients pass (835 stable pins,745 unchanged prior;25create/2bind faultcuts), source/execution review complete and all4 production-entry definitions still required. Complete native startup/profile/overlay/input/game acceptance OPEN. Prior published fork ', 1)
    q.write_bytes(text.encode('utf-8'))
q = R / 'RESULTS.md'; text = q.read_text(encoding='utf-8').replace('Independent saved-execution review is pending.',
    'Independent saved-execution review verifies867 current input pins, all835 measured source hashes,745 unchanged inputs,4 exact runtime/ABI/linkage joins,25/2 faultcuts and actual4-symbol incomplete-entry refusal. No blocking contradiction was found.')
q.write_bytes(text.encode('utf-8'))
receipt = R / 'PUBLICATION.json'
receipt.open('x', encoding='utf-8', newline='\n').write(json.dumps(dict(status='NATIVE_RETAIL_MEMORY_OWNER_LOCAL_CHECKPOINT',
    fork_commit=head, fork_sync=sync_f, verification_sha256=sha(vf), source_pins=835, untouched_prior_pins=745,
    primary_words_rejoined=1222, actual_fault_counts=v['actual_fault_counts'],
    fixture_binaries={x['component']: x['executed_target_sha256'] for x in v['fixtures']},
    game_acceptance='OPEN', owner_action='none'), indent=2) + '\n')
parent_files.add(receipt)
phead, sync_p = commit_sync(P, parent_files, 'Record verified native startup owner phase and exact following source order', remote_p)
for name, digest in v['source_after_sha256'].items(): need(sha(name) == digest, 'measured inputs stable after commit')
print(json.dumps(dict(status='NATIVE_RETAIL_MEMORY_OWNER_COMPONENT_COMMITTED', fork_commit=head, parent_commit=phead,
    fork_sync=sync_f, parent_sync=sync_p, game_acceptance='OPEN')), flush=True)
