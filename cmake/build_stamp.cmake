# Writes the build stamp header that ps2run prints at startup.
#
# Every run log then names the exact source state and compiler that produced the
# binary, so two runs can be compared without guessing. Runs with this header are
# bisectable: the commit plus the dirty flag say whether the binary matches main.
#
# Invoked by the ps2_build_stamp target on every build:
#   cmake -DPS2_SOURCE_DIR=<src> -DPS2_OUTPUT=<header> -DPS2_BUILD_TYPE=<type>
#         -DPS2_COMPILER=<id> -P cmake/build_stamp.cmake

if(NOT PS2_SOURCE_DIR OR NOT PS2_OUTPUT)
    message(FATAL_ERROR "build_stamp.cmake needs PS2_SOURCE_DIR and PS2_OUTPUT")
endif()

set(ps2_commit "unknown")
set(ps2_state "unknown")

find_program(PS2_GIT_EXECUTABLE git)
if(PS2_GIT_EXECUTABLE)
    execute_process(
        COMMAND "${PS2_GIT_EXECUTABLE}" rev-parse --short HEAD
        WORKING_DIRECTORY "${PS2_SOURCE_DIR}"
        OUTPUT_VARIABLE ps2_commit
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE ps2_git_result
        ERROR_QUIET)
    if(NOT ps2_git_result EQUAL 0)
        set(ps2_commit "unknown")
    endif()

    # Tracked files only: an untracked build folder must not mark every build dirty.
    execute_process(
        COMMAND "${PS2_GIT_EXECUTABLE}" status --porcelain --untracked-files=no
        WORKING_DIRECTORY "${PS2_SOURCE_DIR}"
        OUTPUT_VARIABLE ps2_status
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(ps2_status)
        set(ps2_state "dirty")
    elseif(ps2_commit STREQUAL "unknown")
        set(ps2_state "unknown")
    else()
        set(ps2_state "clean")
    endif()
endif()

if(NOT PS2_BUILD_TYPE)
    set(PS2_BUILD_TYPE "unspecified")
endif()
if(NOT PS2_COMPILER)
    set(PS2_COMPILER "unspecified")
endif()

string(TIMESTAMP ps2_built "%Y-%m-%dT%H:%M:%SZ" UTC)

set(ps2_stamp "commit ${ps2_commit} ${ps2_state}, built ${ps2_built}, ${PS2_BUILD_TYPE}, ${PS2_COMPILER}")
set(ps2_stamp_escaped "${ps2_stamp}")
string(REPLACE "\\" "\\\\" ps2_stamp_escaped "${ps2_stamp_escaped}")
string(REPLACE "\"" "\\\"" ps2_stamp_escaped "${ps2_stamp_escaped}")

file(WRITE "${PS2_OUTPUT}"
"// Generated by cmake/build_stamp.cmake. Do not edit.\n"
"#pragma once\n"
"#define PS2_BUILD_COMMIT \"${ps2_commit}\"\n"
"#define PS2_BUILD_STATE \"${ps2_state}\"\n"
"#define PS2_BUILD_TIME \"${ps2_built}\"\n"
"#define PS2_BUILD_TYPE \"${PS2_BUILD_TYPE}\"\n"
"#define PS2_BUILD_STAMP \"${ps2_stamp_escaped}\"\n")
